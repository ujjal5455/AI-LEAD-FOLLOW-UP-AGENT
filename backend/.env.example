# ─── Backend configuration ──────────────────────────────────────────────────
# Copy this file to `.env` in this folder and fill in the values.
# `.env` is git-ignored. Never commit real secrets.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection URL.
#   Local (scripts/local_db.py or `docker compose up -d`):
#     postgresql://postgres:postgres@localhost:5433/lead_agent
#   Supabase: Project → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lead_agent

# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login lasts, in minutes (10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Tests use a temporary database automatically. Set this only to use your own
# (its name must contain "test" — tests delete all data in it).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lead_agent_test

# ─── AI (used from Milestone 3) ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# ─── WhatsApp Cloud API (used from Milestone 8) ──────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Used to verify that incoming webhooks really come from Meta.
WHATSAPP_APP_SECRET=
